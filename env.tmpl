# READ-ONLY:
# Edit ~/etc/env.templ then
# run `hostcfg` to apply


# set -a # export all, no errors allowed
# *******************************************************************************************************

# === LOCALE
LANG='en_CA.UTF-8'
LC_ALL='en_CA.UTF-8'
TZ='America/Toronto'


# === DISCOVERY
CARGO_HOME="$HOME/.cargo"
GOPATH=$HOME/.go
NVM_DIR="$HOME/.nvm"
PATH=$PATH:${GOPATH}/bin
HOSTFILE=$HOME/etc/Hostfile  # deprecated in favour of Ansible
WATCHFILE="$HOME/Watchfile"


# === DATA STORAGE
XDG_DATA_HOME=/data
HELIX_RUNTIME=$XDG_DATA_HOME/helix
PASSWORD_STORE_DIR=$XDG_DATA_HOME/vault
UNISON=$XDG_DATA_HOME/unison
DNS_CONTROL_DIR=$XDG_DATA_HOME/dns
_ZO_DATA_DIR=$XDG_DATA_HOME/zoxide 	# zoxide


# HISTORY
# ------------------
HISTCONTROL=ignoreboth       # ignore duplicates and lines starting with space
HISTSIZE=5000
HISTFILESIZE=10000


# FILE READ/WRITE
# ------------------
EDITOR=hx
BAT_STYLE="changes,header,header-filename,header-filesize,snip"
STARSHIP_CMD_STATUS=0        # for prompt string


# ENDPOINTS
# ----------------------------
CALDAV_URL="https://caldav.alj.cx"

CHARM_HOST=firelink
CHARM_SSH_PORT=3300
CHARM_HTTP_PORT=3400

NATS_URL='nats://nats:4222'

NTFY_URL={{ getpw "ntfy/url" }}


# API KEYS
# ---------------------------
BELFRY_TOKEN={{ getpw "belfry/token" }}

CHRONCAL_SMTP_USERNAME={{ getpw "smtp/user" }}
CHRONCAL_SMTP_PASSWORD={{ getpw "smtp/pass" }}

CALDAV_USER={{ getpw "caldav/user" }}
CALDAV_PASS="{{ getpw "caldav/pass" }}"
CALDAV_API_KEY={{ getpw "caldav/api-key" }}

GITHUB_TOKEN={{ getpw "github/token" }}

NTFY_TOKEN={{ getpw "ntfy/token" }}
NTFY_TOKEN_64=$( echo -n "Bearer $NTFY_TOKEN" | base64 )

TASKDOG_API_KEY={{ getpw "taskdog/api_key" }}


# ********************************************************************************************
# set +a # end export

#!/bin/bash

#    ██████████ ██████   █████ █████   █████
#   ░░███░░░░░█░░██████ ░░███ ░░███   ░░███ 
#    ░███  █ ░  ░███░███ ░███  ░███    ░███ 
#    ░██████    ░███░░███░███  ░███    ░███ 
#    ░███░░█    ░███ ░░██████  ░░███   ███  
#    ░███ ░   █ ░███  ░░█████   ░░░█████░   
# ██ ██████████ █████  ░░█████    ░░███     
#░░ ░░░░░░░░░░ ░░░░░    ░░░░░      ░░░      

# GENERAL
# ------------------
export CONFIG="$HOME/etc"
export TZ="America/Toronto"
export EDITOR='micro -eofnewline false'     # TUI, no new lines for gopass
export VISUAL='code --new-window --wait'    # GUI, wait files to load
LANG='en_CA.UTF-8'
LC_ALL='en_CA.UTF-8'

# PATH EXTENSIONS
# -----------------
export PATH="$PATH\
:$HOME/bin\
:$HOME/go/bin\
:/usr/local/go/bin"

# GO
#--------------
export GOBIN="$HOME/bin"

# =============================== batcat
# no numbers, no rule
export BAT_STYLE="changes,header,header-filename,header-filesize,snip"

#============================================================ git
export GITHUB='https://github.com/ax-mad'
export GIT_CONFIG_GLOBAL="$CONFIG/git/config"
export GH_CONFIG="$CONFIG/gh/config.yml"

#==================== starship
export STARSHIP_CONFIG="$CONFIG/starship/config"
#===================== starship

############################
# API KEYS
############################

export REMINDER_API_TOKEN={{ getpw "belfry/token" }}
export NTFY_URL={{ getpw "ntfy/url" }}
export NTFY_TOKEN={{ getpw "ntfy/token" }}
export TASKDOG_API_KEY={{ getpw "taskdog/api_key" }}

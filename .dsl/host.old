#!/usr/bin/env bash
# =============================================================================
# host — declare desired /etc/hosts state and host metadata
#
#   host NAME [at IP]
#       is TAG...
#       os VALUE
#       de VALUE
#   :
#
# `host NAME` opens a scoped declaration. Child statements (`is`, `os`, `de`)
# apply only to that open scope. The scope closes with a bare `:` on its own
# line, at which point the declaration is validated, /etc/hosts is converged,
# persistent host state is updated, and a single summary line is emitted.
#
# The minimal form omits children entirely:
#
#   host NAME at IP
#   :
#
# The IP may be omitted, in which case previously stored state is reused,
# falling back to 127.0.0.1 for a first-time declaration with no `at`.
#
# Persistent state lives at $ROOT/.cache/host/state.json. $ROOT must already
# be exported by the entrypoint; this file never guesses it.
# =============================================================================

HOSTS_FILE="/etc/hosts"
HOST_TAG="# env:host"

# Fallback printer if 'msg' is not defined in entrypoint context.
if ! declare -f msg >/dev/null; then
    msg() {
        local directive="$1"; shift
        printf '%-11s %s\n' "$directive" "$*"
    }
fi

if ! declare -f error >/dev/null; then
    error() {
        printf 'error: %s\n' "$*" >&2
    }
fi

# -----------------------------------------------------------------------------
# $ROOT / state file resolution — no fallback discovery, ever.
# -----------------------------------------------------------------------------

_host_require_root() {
    if [[ -z "${ROOT:-}" ]]; then
        error "host: \$ROOT is not set (expected to be exported by the entrypoint)"
        return 1
    fi
    if [[ ! -d "$ROOT" ]]; then
        error "host: \$ROOT ('$ROOT') is not a directory"
        return 1
    fi
}

_host_state_file() {
    printf '%s/.cache/host/state.json' "$ROOT"
}

_host_require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        error "host: jq is required but not found on PATH"
        return 1
    fi
}

_host_ensure_state_file() {
    local state_file
    state_file="$(_host_state_file)"
    local dir
    dir="$(dirname "$state_file")"
    mkdir -p "$dir" || {
        error "host: failed to create state directory '$dir'"
        return 1
    }
    if [[ ! -f "$state_file" ]]; then
        printf '{}' > "$state_file" || {
            error "host: failed to initialize state file '$state_file'"
            return 1
        }
    fi
}

# -----------------------------------------------------------------------------
# Validation helpers
# -----------------------------------------------------------------------------

_host_normalize_name() {
    local name="${1:-}"
    name="${name%.}"
    printf '%s' "${name,,}"
}

_host_normalize_ip() {
    local ip="${1:-}"
    if [[ "$ip" == *:* ]]; then
        if command -v python3 >/dev/null 2>&1; then
            python3 -c "import ipaddress,sys; print(ipaddress.ip_address(sys.argv[1]).compressed)" "$ip" 2>/dev/null || printf '%s' "${ip,,}"
        else
            printf '%s' "${ip,,}"
        fi
    else
        printf '%s' "$ip"
    fi
}

_host_validate_name() {
    local name="${1:-}"
    [[ "$name" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*$ ]]
}

_host_validate_ip() {
    local ip="${1:-}"
    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        local octet octets
        IFS='.' read -r -a octets <<< "$ip"
        for octet in "${octets[@]}"; do
            (( octet >= 0 && octet <= 255 )) || return 1
        done
        return 0
    fi
    [[ "$ip" =~ ^[0-9a-fA-F:]+$ && "$ip" == *:* ]]
}

validate_host_syntax() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        error "host: missing mandatory host name"
        return 1
    fi

    _host_validate_name "$name" || {
        error "host: invalid host name '$name'"
        return 1
    }
}

# -----------------------------------------------------------------------------
# Pending scope state — cleared entirely on open and on close.
# Lifetime: from `host NAME` to the matching `:`. Never persisted as-is.
# -----------------------------------------------------------------------------

_HOST_SCOPE_OPEN=0
_HOST_PENDING_NAME=""
_HOST_PENDING_AT=""
_HOST_PENDING_IS=()
_HOST_PENDING_OS=""
_HOST_PENDING_DE=""

_host_reset_scope() {
    _HOST_SCOPE_OPEN=0
    _HOST_PENDING_NAME=""
    _HOST_PENDING_AT=""
    _HOST_PENDING_IS=()
    _HOST_PENDING_OS=""
    _HOST_PENDING_DE=""
}

_host_require_open_scope() {
    local caller="$1"
    if [[ "$_HOST_SCOPE_OPEN" -ne 1 ]]; then
        error "$caller: no active host declaration"
        return 2
    fi
}

# -----------------------------------------------------------------------------
# host NAME [at IP]  — opens a scope
# -----------------------------------------------------------------------------

host() {
    if [[ "$_HOST_SCOPE_OPEN" -eq 1 ]]; then
        error "host: a host declaration for '$_HOST_PENDING_NAME' is still open (missing ':')"
        return 2
    fi

    local name="${1:-}" prep="${2:-}" ip="${3:-}"

    validate_host_syntax "$name" || return 1

    if [[ -n "$prep" ]]; then
        if [[ "$prep" != "at" ]]; then
            error "host: unknown preposition '$prep' (expected 'at')"
            return 1
        fi
        if [[ -z "$ip" ]]; then
            error "host: 'at' requires an IP address"
            return 1
        fi
        _host_validate_ip "$ip" || {
            error "host: invalid IP address '$ip'"
            return 1
        }
    fi

    _host_reset_scope
    _HOST_SCOPE_OPEN=1
    _HOST_PENDING_NAME="$(_host_normalize_name "$name")"
    if [[ -n "$ip" ]]; then
        _HOST_PENDING_AT="$ip"
    fi

    return 0
}

# -----------------------------------------------------------------------------
# is TAG...  — one or more whitespace-separated tags
# -----------------------------------------------------------------------------

is() {
    _host_require_open_scope "is" || return $?

    if [[ $# -eq 0 ]]; then
        error "is: expected one or more tags"
        return 2
    fi

    _HOST_PENDING_IS+=("$@")
}

# -----------------------------------------------------------------------------
# os VALUE  — exactly one token
# -----------------------------------------------------------------------------

os() {
    _host_require_open_scope "os" || return $?

    if [[ $# -ne 1 ]]; then
        error "os: expected exactly one value"
        return 2
    fi

    _HOST_PENDING_OS="$1"
}

# -----------------------------------------------------------------------------
# de VALUE  — exactly one token
# -----------------------------------------------------------------------------

de() {
    _host_require_open_scope "de" || return $?

    if [[ $# -ne 1 ]]; then
        error "de: expected exactly one value"
        return 2
    fi

    _HOST_PENDING_DE="$1"
}

# -----------------------------------------------------------------------------
# :  — closes the scope, applies state, emits summary
# -----------------------------------------------------------------------------

:() {
    if [[ "$_HOST_SCOPE_OPEN" -ne 1 ]]; then
        error "host: ':' with no active host declaration"
        return 2
    fi

    local name="$_HOST_PENDING_NAME"
    local ip="$_HOST_PENDING_AT"

    _host_require_root || { _host_reset_scope; return 1; }
    _host_require_jq   || { _host_reset_scope; return 1; }
    _host_ensure_state_file || { _host_reset_scope; return 1; }

    local state_file
    state_file="$(_host_state_file)"

    # Resolve IP: explicit binding this scope, else whatever is already
    # stored. No fabricated default — a host with no known IP simply has
    # no known IP, and gets no /etc/hosts entry.
    if [[ -z "$ip" ]]; then
        ip="$(jq -r --arg n "$name" '.[$n].ip // empty' "$state_file")"
    fi

    if [[ -n "$ip" ]]; then
        _host_validate_ip "$ip" || {
            error "host: resolved IP '$ip' for '$name' is invalid"
            _host_reset_scope
            return 1
        }
    fi

    local status=""
    if [[ -n "$ip" ]]; then
        status="$(_host_apply_etc_hosts "$name" "$ip")" || { _host_reset_scope; return 1; }
    fi

    # Merge tags: explicit `is` values this scope, deduped, order-preserving.
    local -a tags=()
    if [[ ${#_HOST_PENDING_IS[@]} -gt 0 ]]; then
        local t seen=""
        for t in "${_HOST_PENDING_IS[@]}"; do
            [[ " $seen " == *" $t "* ]] && continue
            tags+=("$t")
            seen+=" $t"
        done
    fi

    local os_val="$_HOST_PENDING_OS"
    local de_val="$_HOST_PENDING_DE"

    # Persist: explicit fields from this scope overwrite; omitted fields
    # (empty tags array / empty os / empty de) preserve prior stored values.
    local tags_json
    tags_json="$(printf '%s\n' "${tags[@]}" | jq -R . | jq -s .)"

    local tmp
    tmp="$(mktemp)" || { error "host: failed to create temp file"; _host_reset_scope; return 1; }

    if ! jq \
        --arg n "$name" \
        --arg ip "$ip" \
        --argjson tags "$tags_json" \
        --arg os "$os_val" \
        --arg de "$de_val" \
        --arg has_tags "$([[ ${#tags[@]} -gt 0 ]] && echo 1 || echo 0)" \
        --arg has_os "$([[ -n "$os_val" ]] && echo 1 || echo 0)" \
        --arg has_de "$([[ -n "$de_val" ]] && echo 1 || echo 0)" \
        '
        .[$n] = ((.[$n] // {}) as $prev |
            {
                ip: $ip,
                is: (if $has_tags == "1" then $tags else ($prev.is // []) end),
                os: (if $has_os == "1" then $os else ($prev.os // "") end),
                de: (if $has_de == "1" then $de else ($prev.de // "") end)
            }
        )
        ' "$state_file" > "$tmp"
    then
        error "host: failed to update state for '$name'"
        rm -f "$tmp"
        _host_reset_scope
        return 1
    fi
    mv "$tmp" "$state_file"

    # Build the summary line from the (post-merge) stored state.
    local summary_tags
    summary_tags="$(jq -r --arg n "$name" '.[$n] |
        ([.is[]?, .os, .de] | map(select(. != "" and . != null)) | join(", "))' "$state_file")"

    local location="" parenthetical=""
    if [[ -n "$ip" ]]; then
        location=" at $ip"
        parenthetical=" ($status)"
    else
        parenthetical=" (no ip)"
    fi

    if [[ -n "$summary_tags" ]]; then
        msg HOST "${name}${location} [$summary_tags]${parenthetical}"
    else
        msg HOST "${name}${location}${parenthetical}"
    fi

    _host_reset_scope
}

# -----------------------------------------------------------------------------
# /etc/hosts convergence (unchanged approach from the prior implementation)
# -----------------------------------------------------------------------------

_host_apply_etc_hosts() {
    local name="$1" ip="$2"
    local ip_norm existing_tagged existing_untagged status

    ip_norm="$(_host_normalize_ip "$ip")"

    existing_tagged="$(awk -v n="$name" -v tag="$HOST_TAG" '
        $0 ~ tag {
            for (i=2; i<=NF; i++) {
                sub(/#.*/, "", $i)
                if (tolower($i) == n) { print $1; exit }
            }
        }
    ' "$HOSTS_FILE" 2>/dev/null || true)"

    existing_untagged="$(awk -v n="$name" -v tag="$HOST_TAG" '
        $0 !~ tag && $1 !~ /^#/ {
            for (i=2; i<=NF; i++) {
                if (tolower($i) == n) { print $1; exit }
            }
        }
    ' "$HOSTS_FILE" 2>/dev/null || true)"

    if [[ -n "$existing_tagged" ]]; then
        if [[ "$(_host_normalize_ip "$existing_tagged")" == "$ip_norm" ]]; then
            printf 'unchanged'
            return 0
        fi
        status="updated"
    elif [[ -n "$existing_untagged" ]]; then
        if [[ "$(_host_normalize_ip "$existing_untagged")" == "$ip_norm" ]]; then
            status="adopted"
        else
            status="updated"
        fi
    else
        status="declared"
    fi

    local tmp
    tmp="$(mktemp)"

    awk -v n="$name" -v new_ip="$ip" -v tag="$HOST_TAG" '
        BEGIN { updated = 0 }
        {
            if ($0 ~ /^[[:space:]]*#/ || NF == 0) {
                print $0
                next
            }

            has_target = 0
            new_line = $1
            comment = ""

            for (i = 2; i <= NF; i++) {
                if ($i ~ /^#/) {
                    for (j = i; j <= NF; j++) comment = comment (j==i?"":" ") $j
                    break
                }
                if (tolower($i) == n) {
                    has_target = 1
                } else {
                    new_line = new_line "\t" $i
                }
            }

            if (has_target) {
                if (length(new_line) > length($1)) {
                    print (comment != "" ? new_line "\t" comment : new_line)
                }
                if (!updated) {
                    printf "%s\t%s\t%s\n", new_ip, n, tag
                    updated = 1
                }
            } else {
                print $0
            }
        }
        END {
            if (!updated) {
                printf "%s\t%s\t%s\n", new_ip, n, tag
            }
        }
    ' "$HOSTS_FILE" > "$tmp"

    sudo cp "$tmp" "$HOSTS_FILE"
    sudo chmod 644 "$HOSTS_FILE"
    rm -f "$tmp"

    printf '%s' "$status"
}

#!/bin/bash

# **********************************
# * MY SHELL ENVIRONMENT VARIABLES *
# **********************************

CONFIG="$HOME/etc"
export TZ="America/Toronto"
LANG='en_CA.UTF-8'
LC_ALL='en_CA.UTF-8'

# PATH EXTENSIONS
# -----------------
export PATH="$PATH\
:$HOME/bin\
:$HOME/go/bin\
:/usr/local/go/bin"

# GO
#--------------
export GOOS='linux'   # OR 'windows'
export GOARCH='amd64' # because my architecture is x86_64
export GOPATH="$HOME/bin"

# =============================== batcat
# no numbers, no rule
export BAT_STYLE="changes,header,header-filename,header-filesize,snip"

EDITOR='micro'                            # default TUI editor
VISUAL='micro'
# VISUAL='code --new-window --wait'       # default GUI editor for Linux

#bc
BC_ENV_ARGS='-lq'

#============================================================ git
export GITHUB='https://github.com/ax-mad'
export GIT_CONFIG_GLOBAL="$CONFIG/git/config"
export GH_CONFIG="$CONFIG/gh/config.yml"

#============================================================ gum
# GUM_INPUT_HEADER_FOREGROUND=""

GUM_CHOOSE_CURSOR_PREFIX="[ ] "
GUM_CHOOSE_UNSELECTED_PREFIX="[ ] "
GUM_CHOOSE_SELECTED_PREFIX="[x] "

GUM_FILTER_UNSELECTED_PREFIX="[ ] "
GUM_FILTER_SELECTED_PREFIX="[x] "
GUM_FILTER_INDICATOR="> "
GUM_FILTER_PROMPT="/"

GUM_CHOOSE_ITEM_FOREGROUND="7"       # white
GUM_CHOOSE_CURSOR_FOREGROUND="44"    # cyan
GUM_CHOOSE_SELECTED_FOREGROUND="40"  # green

GUM_FILTER_INDICATOR_FOREGROUND="44"
GUM_FILTER_SELECTED_PREFIX_FOREGROUND="40"

#============================================================ /gum

# less
LESS='--RAW-CONTROL-CHARS --shift=4 --quit-if-one-screen  --tilde --LONG-PROMPT --wordwrap' # -RS#FX~M


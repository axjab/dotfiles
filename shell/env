export CALDAV_API_KEY={{ getpw "caldav/api-key" }}

export NATS_URL='nats://nats:4222'

export NTFY_URL={{ getpw "ntfy/url" }}
export NTFY_TOKEN={{ getpw "ntfy/token" }}

# exec ~/env/rebuild to apply

# GENERAL
# ------------------
LANG='en_CA.UTF-8'
LC_ALL='en_CA.UTF-8'
export PATH=$PATH:/exe
export TZ="America/Toronto"
EDITOR=hx
# export EDITOR='micro -eofnewline false'     # TUI, no new lines for gopass
# export VISUAL='code --new-window --wait'    # GUI, wait files to load
#-----------

# EDITING
# ------------------
export BAT_STYLE="changes,header,header-filename,header-filesize,snip"
if [[ -z "$SSH_CONNECTION" ]] && \
   command -v code >/dev/null 2>&1 && \
   { [[ -n "$DISPLAY" ]] || [[ -n "$WAYLAND_DISPLAY" ]]; }; then
    export EDITOR=hx
    export VISUAL='code --new-window --wait'
else
    # export EDITOR='micro -eofnewline false'
	export EDITOR=hx
    export VISUAL="$EDITOR"
fi

# DATA MANAGEMENT
# ---------------------------
export HELIX_RUNTIME=/data/helix
export PASSWORD_STORE_DIR="/data/secrets"
export UNISON=/data/unison
export GOPATH=/exe


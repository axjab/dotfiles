
Host *
	IdentityFile ~/.ssh/key
	IdentitiesOnly yes

Host old_shrine
    Hostname 100.121.116.55
    User ash

# Host firelink
	# Hostname ???

Host majula
    Hostname 100.109.130.76
    User solaire

Host github gh
	Hostname github.com
	User git

Host gitlab
	Hostname gitlab.thalesdigital.io
	User git

Host archive arc
	Hostname majula
	User arc

Host git repo
    Hostname majula
	User git

Host www web
	Hostname firelink
    User www

Host hooks webhooks
	Hostname firelink
	User hooks

Host publish pub
	Hostname firelink
    User dufs

Host apt
	Hostname firelink
    User apt

Host python py
	Hostname firelink
    User python

# ── Usage (shell commands) ──────────────────────────────
# git clone git:my-repo
# rsync -av dist/ pkg:python/
# rsync -av fs:documents/ ~/documents/
# sshfs fs: ~/mnt/fs
# sshfs -o ro www: ~/mnt/www
# sshfs pub: ~/mnt/pub
# rsync -av file.txt drop:
# rsync -av ~/docs/ bak:docs/
# ssh fs                         # If shell access allowed

	at=100.121.116.55
	user=ash
	os=Debian
: # use this --- or ~~ as scope terminators

# THE SCOPE TERMINATOR --- is a legitimate directive
# which executes the LAST CALLED directive with additional context
# Here is how it works:
# SCOPED_DIRECTIVE [args...]   	# a SCOPED_DIRECTIVE may be in a single line
# 															# in such cases, it can either be:
# 															# 1. Implicitely terminated with a special arg
# 															# 2. Explicitely terminated with a scope terminator
#
# 	x=a													# The previous directive is now in-effect.
# 	y=b													# Every subsequent variable will be contained
# 	z=c													# only within its scope or context
# ---														# This directive collects all declared variables
# 															# and reexecutes the directive like:
# 				x=a y=b z=c SCOPED_DIRECTIVE [args...] ---

Host majula at 100.109.130.76
	is='headless server'
	at=100.109.130.76

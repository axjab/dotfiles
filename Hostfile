namespace data  # Mutable state
namespace repo  # Shared file repository
namespace exe 	# sync with axjab/executable(?) # Non-system executables
namespace log   # Non-system log aggregation
namespace net   links to ~/host/net # Network topology
namespace svc   links to ~/host/svc # Services
namespace job   links to ~/host/job # Recurring jobs

require internet  # ensures host is connected to the Internet. Prompt to continue in offline mode if not.
require tailnet   # ensures host is connected to the Tailnet. Prompt to continue.

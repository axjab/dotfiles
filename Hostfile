#!/usr/bin/env bash 

# Configfile a.k.a Hostfile

bin='/exe from github:axjab/executables'
vault='/data/secrets from github:axjab/vault'

# IDENTITY
create key gpg
create key ssh

# INGREDIENTS
hook tailnet	"Tailnet authenticated"
hook github		"Github	authenticated"
# hook garage		"S3 API authenticated"
# hook nats			"Connected to NATS"
sync $bin
sync $vault

# SYSTEM CONFIG
copy sudo/secure-path to /etc/sudoers.d/ READ-ONLY

# HOSTS ******************************************

host firelink
	is='headless server'
	at=100.121.116.55
	user=ash
	os=Debian
:
host majula
	is='headless server'
	at=100.109.130.76
	user=solaire
	os=Debian
:
host xenon
	is='nvidia gaming pc'
	at=100.66.43.42
	user=ash
	os=PikaOS
	de=Niri
:
host luminous
	is='nvidia gaming pc'
	at='100.95.238.38'
	user=axjab
	os=PikaOS
	de=Niri
:
host aran
	is='low-powered pc'
	os=Debian
:

# SERVICES ****************************************

host service wiki 				at localhost
host service nats					at majula
host service repository		at majula
host service pocketbase		at majula
host service uptime-kuma	at majula

# INSTALLATION ************************************

install	eza
install tree
install tldr
install nfs-common
install unison
install kitty-terminfo

install vivaldi IF NOT headless
install code		IF NOT headless

exit 1

# FILESYSTEM MOUNTPOINTS **************************
set +e

# for all but majula  ( only execute this step if host is NOT majula)
		mount nfs majula:/mnt/ssd 			onto /mnt/majula.ssd
		mount dir /mnt/majula.ssd/files onto /repo

# for majula
	mount dir /mnt/ssd/data/garage	onto /data/garage/data

set -e

# CONFIGURATION ***********************************
link /usr/bin/pinentry-curses to /usr/bin/pinentry

link gopass/config	to ~/.config/gopass/config
process	 shell/env 	to ~/.env
link shell/aliases	to ~/.aliases
link shell/bashrc  	to ~/.bashrc
sync /data/helix		with 'ssh://majula//data/helix'
sync ~/host  # move to .host?
link niri/config.kdl			to ~/.config/niri/config.kdl
link niri/animation				to ~/.config/niri/animation
link helix/config.toml		to ~/.config/helix/config.toml
link helix/lang.toml			to ~/.config/helix/languages.toml
link ~/.config/helix 			to /root/.config/helix
process aichat/config.yaml 	to ~/.config/aichat/config.yaml    # if u can get secret for ~/.env, a symlink would suffice
link bat/config						to /etc/bat/config
link gh/config.yml				to ~/.config/gh/config.yml
link git/config						to /etc/gitconfig
# link gnupg/config					to ~/.gnupg/gpg-agent.conf
link sqlite/config				to ~/.sqliterc
link starship/config			to ~/.config/starship.toml
link taskdog/cli.toml			to ~/.config/taskdog/cli.toml
link xdg/dirs 						to ~/.config/user-dirs.dirs   # /etc is preferable

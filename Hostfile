export DSL="$ROOT/.dsl"		# contains language definitions
export GUM_SPIN_SPINNER=meter
export GUM_SPIN_ALIGN=left
export GUM_SPIN_TIMEOUT=300s
export GUM_SPIN_SHOW_ERROR=true
